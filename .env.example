# Database
DATABASE_URL=postgresql://bukupay:bukupay123@localhost:5432/bukupay
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Xendit
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CALLBACK_URL=https://api.bukupay.id/webhooks/xendit

# Verihubs (eKYC)
VERIHUBS_CLIENT_ID=
VERIHUBS_API_KEY=
VERIHUBS_BASE_URL=https://api.verihubs.com

# WhatsApp Business API (Meta)
WA_API_URL=https://graph.facebook.com/v18.0/
WA_API_KEY=
WA_PHONE_NUMBER_ID=

# SMS Fallback (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Firebase (FCM)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# AWS S3 (KTP & Selfie upload)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=bukupay-kyc
AWS_REGION=ap-southeast-3

# App Config
NODE_ENV=development
PORT=3000
APP_NAME=BukuPay
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_MAX=5

# ============================================================
# Phase 2 Variables
# ============================================================

# MQTT Broker (Mosquitto lokal / AWS IoT Core production)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_TLS_URL=mqtts://broker.bukupay.id:8883
MQTT_USERNAME=backend
MQTT_PASSWORD=bukupay_mqtt_change_this
MQTT_TLS=false

# Pencairan Instan (Xendit Instant Disbursement)
INSTANT_SETTLEMENT_FEE=2500
INSTANT_SETTLEMENT_MIN=50000

# App Deep Link (untuk invite karyawan)
APP_DEEP_LINK=https://app.bukupay.id

# Web Dashboard (Next.js)
NEXT_PUBLIC_API_URL=https://api.bukupay.id
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=https://dashboard.bukupay.id
INTERNAL_API_URL=http://backend:3000/api

# iOS Push Notification (APNs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
