# ============================================================
# .env — Docker Compose environment variables
# Copy this to .env and fill in the values
# cp .env.docker.example .env
# ============================================================

# ─── Database ────────────────────────────────────────────────
DB_USER=bukupay
DB_PASSWORD=bukupay123_change_in_prod
DB_NAME=bukupay
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=               # leave empty for dev, set in prod

# ─── MQTT (Mosquitto) ────────────────────────────────────────
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=backend
MQTT_PASSWORD=bukupay_mqtt_change_this

# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000             # expose backend on host (dev only)
WEB_PORT=3001                 # expose web on host (dev only)

# ─── Web Dashboard ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev_secret_change_in_production_minimum_32_chars

# ─── Production only ─────────────────────────────────────────
# REGISTRY=ghcr.io/bukupay
# VERSION=latest
