# ============================================================
# apps/web/.env.local — Next.js environment (local/Docker)
# Fill in actual values
# ============================================================

# API URL yang di-call dari browser (via nginx proxy)
NEXT_PUBLIC_API_URL=http://localhost/api

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev_secret_change_in_production_minimum_32_chars

# Internal API URL untuk server-side fetching (container-to-container)
INTERNAL_API_URL=http://backend:3000
